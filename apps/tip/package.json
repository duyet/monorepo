    "cf:deploy:prod": "../../scripts/cf-deploy-prod.sh tip duyet-tip"
  },
  "dependencies": {
    "@duyet/components": "*",
    "@duyet/libs": "*",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@duyet/tailwind-config": "*",
    "@duyet/tsconfig": "*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "typescript": "*",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.0.0"
  }
}
