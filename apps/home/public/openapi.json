                      "type": "integer"
                    },
                    "human_lines_added": {
                      "type": "integer"
                    },
                    "total_lines_added": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "ai_percentage",
                    "total_lines_added",
                    "human_lines_added",
                    "ai_lines_added"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Latest AI code percentage snapshot.",
            "headers": {
              "RateLimit-Limit": {
