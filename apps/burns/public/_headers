/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed JS/CSS: filename carries a content hash → cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Daily-refreshed usage data: 5 min in the browser, edge SWR (deploy purges the cache)
/token-data.json
  Cache-Control: public, max-age=300, s-maxage=86400, stale-while-revalidate=86400

/og.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000

/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000
