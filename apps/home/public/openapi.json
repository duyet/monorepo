              },
              "days": {
                "type": "integer"
              },
              "generatedAt": {
                "format": "date-time",
                "type": "string"
              },
              "totalPageviews": {
                "type": "integer"
              },
              "totalRequests": {
                "type": "integer"
              }
            },
            "required": [
