#!/bin/sh
# Run the full test suite before a commit.
#
# Redirect to a temp file to avoid a pipe-buffer overflow with 20+ concurrent
# test suites; on failure, cat the output so you can see which test broke.
#
# `test:turbo` rather than `test`, deliberately. The root `test` script is
# `dotenv -- turbo test && pnpm run test:scripts`, and turbo defaults to 10
# parallel tasks. In this 29-package monorepo that starts 10 vitest processes
# at once, and on a memory-limited machine the whole run gets OOM-killed: a
# *different* task reports exit 143 (SIGTERM) on each run, with no assertion
# failure anywhere in the output. The signature to recognise is that — the
# failing package changes between runs, and it passes when run alone.
#
# `--concurrency=2` measured, not guessed. 4 still failed intermittently on a
# 15 GB box with ~4 GB free; 2 ran 24/24 twice in a row, and
# `@duyet/components` peaks at 385 MB resident on its own. The `dotenv --` prefix
# is preserved so the env files the suites read stay identical.
#
# The scripts suite (66 tests; `scripts/` is not a workspace package so turbo
# never sees it) runs separately afterwards, at its own concurrency.
TMPOUT=$(mktemp)
if ! pnpm run test:turbo > "$TMPOUT" 2>&1; then
  cat "$TMPOUT"
  rm -f "$TMPOUT"
  exit 1
fi
rm -f "$TMPOUT"

if ! pnpm run test:scripts > "$TMPOUT" 2>&1; then
  cat "$TMPOUT"
  rm -f "$TMPOUT"
  exit 1
fi
rm -f "$TMPOUT"

# The lockfile has to match the workspace manifests, because every workflow in
# .github/workflows installs with --frozen-lockfile. A plain `pnpm install`
# silently repairs drift locally, so a package.json change without a matching
# pnpm-lock.yaml looks perfectly healthy on a dev machine and then fails all
# 18 workflows at once. `pnpm run check-lockfile` is the cheapest gate for
# that: it reports, and never repairs.
if ! pnpm run check-lockfile; then
  exit 1
fi
