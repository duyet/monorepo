# Security headers
/*
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com https://cdn.seline.so https://pageview.duyet.net https://www.clarity.ms https://scripts.clarity.ms https://app.posthog.com https://j.duyet.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Hashed assets: immutable long cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Build-generated gallery data: 5 min in the browser, edge SWR (deploy purges the cache)
/photos-data.json
  Cache-Control: public, max-age=300, s-maxage=86400, stale-while-revalidate=86400

/photos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000

/og.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000

/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
