          "ai_lines_added": {
            "type": "integer"
          },
          "date": {
            "type": "string"
          },
          "human_commits": {
            "type": "integer"
          },
          "human_lines_added": {
            "type": "integer"
          },
          "total_commits": {
            "type": "integer"
          },
          "total_lines_added": {
            "type": "integer"
          }
        },
        "required": [
          "date",
          "ai_percentage",
          "total_lines_added",
          "human_lines_added",
          "ai_lines_added",
          "total_commits",
          "human_commits",
