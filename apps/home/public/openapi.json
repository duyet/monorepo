        "operationId": "getAiPercentageHistory",
        "parameters": [
          {
            "description": "Number of days to look back.",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 365,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiPercentageHistoryResponse"
                }
              }
            },
