# Monorepo environment template.
#
# The repo uses two env file names only:
#   .env.example  this file, committed, placeholders only
#   .env.local    gitignored, holds all secrets and public build-time values
#
# Setup:  cp .env.example .env.local
#
# Scripts (cf:deploy, cf:deploy:prod, config) read the root .env.local.
# CI reads the same names from GitHub Actions secrets and vars.
# VITE_* values are baked into browser bundles at build time, so never put a
# secret behind a VITE_ name.
# apps/agent-assistant has its own apps/agent-assistant/.env.example.

# ---------------------------------------------------------------------------
# Public build-time values (needed for production builds)
# ---------------------------------------------------------------------------

VITE_CLERK_PUBLISHABLE_KEY=
VITE_MEASUREMENT_ID=
POSTHOG_PROJECT_ID=

# ---------------------------------------------------------------------------
# Client config (optional)
# ---------------------------------------------------------------------------

VITE_ASSISTANT_API_TOKEN=
VITE_SELINE_TOKEN=
VITE_AGENT_API_URL=
VITE_LANGGRAPH_API_URL=http://localhost:2024
VITE_GITHUB_REPO_URL=
VITE_BASE_URL=

# ---------------------------------------------------------------------------
# URL overrides (optional)
# Production URLs are defaults in code (packages/urls and `|| "https://api.duyet.net"`).
# Uncomment only to point a local build at another host.
# ---------------------------------------------------------------------------

# VITE_API_BASE_URL=http://localhost:8787
# VITE_DUYET_HOME_URL=http://localhost:3000
# VITE_DUYET_BLOG_URL=http://localhost:3000
# VITE_DUYET_CV_URL=http://localhost:3001
# VITE_DUYET_INSIGHTS_URL=http://localhost:3003
# VITE_DUYET_PHOTOS_URL=http://localhost:3004
# VITE_DUYET_HOMELAB_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Cloudflare (deploy scripts and insights)
# ---------------------------------------------------------------------------

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_KEY=

# ---------------------------------------------------------------------------
# Auth (agent-api and Clerk)
# ---------------------------------------------------------------------------

CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
AGENT_API_TOKEN=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------

POSTHOG_API_KEY=

# ---------------------------------------------------------------------------
# ClickHouse (insights, data-sync)
# ---------------------------------------------------------------------------

CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
CLICKHOUSE_PROTOCOL=

# ---------------------------------------------------------------------------
# MotherDuck (burns)
# ---------------------------------------------------------------------------

MOTHERDUCK_TOKEN=

# ---------------------------------------------------------------------------
# Photos (Unsplash and Cloudinary)
# ---------------------------------------------------------------------------

UNSPLASH_ACCESS_KEY=
UNSPLASH_USERNAME=
PHOTOS_OWNER_USERNAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# ---------------------------------------------------------------------------
# External APIs
# ---------------------------------------------------------------------------

GITHUB_TOKEN=
WAKATIME_API_KEY=
OPENROUTER_API_KEY=
ANYROUTER_API_KEY=
