{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:allNonMajor",
    "schedule:weekly",
    "schedule:automergeWeekly",
    "security:openssf-scorecard"
  ],
  "automerge": true,
  "packageRules": [
    {
      "description": "clerk-react 5.x and @clerk/backend 2.x require @clerk/shared ^3.47. v4 drops ClientContext/OrganizationProvider/SessionContext/UserContext and breaks the blog Vite/rolldown production build.",
      "matchPackageNames": ["@clerk/shared"],
      "allowedVersions": "<4"
    }
  ],
  "ignoreDeps": [
    "@duyet/tsconfig",
    "@duyet/components",
    "@duyet/config",
    "@duyet/libs",
    "@duyet/tailwind-config",
    "@duyet/urls",
    "@duyet/interfaces",
    "@duyet/wasm",
    "@duyet/profile"
  ]
}
