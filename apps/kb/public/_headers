# Cloudflare Pages headers for the knowledge base.
# IMPORTANT: HTML must not use long stale-while-revalidate. After deploy, hashed
# /assets/* filenames change; serving stale HTML that points at deleted JS
# returns index.html (text/html) for module scripts → blank page + MIME error.

# Default (HTML routes): always revalidate; short browser cache only
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=0, must-revalidate

# Hashed JS/CSS: filename is content-addressed → long cache is safe
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Raw markdown endpoints
/*.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate

/graph-data.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
