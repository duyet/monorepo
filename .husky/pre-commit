#!/bin/sh
# Redirect to temp file to avoid pipe buffer overflow with 14+ concurrent test suites.
# On failure, cat the output so you can see which test broke.
#
# --concurrency is capped deliberately. `turbo test` defaults to 10 parallel
# tasks, and a 29-package monorepo means 10 vitest processes plus their tsc
# siblings at once. On a memory-constrained machine that gets the whole run
# OOM-killed: every task reports exit 143 (SIGTERM) and the hook fails with no
# real error in the output, which reads like a broken test but is not one.
# 4 keeps peak memory well under the limit while still running 7 batches.
TMPOUT=$(mktemp)
# `dotenv --` is kept from the root `test` script: it loads .env files, and
# dropping it would change which env vars the suites see.
if ! pnpm exec dotenv -- turbo test --concurrency=4 > "$TMPOUT" 2>&1; then
  cat "$TMPOUT"
  rm -f "$TMPOUT"
  exit 1
fi
rm -f "$TMPOUT"
