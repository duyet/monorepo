{
  "name": "news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pack-extension": "tsx scripts/pack-news-tab.ts",
    "dev": "pnpm run pack-extension && vite dev --port 3014",
    "build": "pnpm run pack-extension && vite build",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint:fix": "biome check --write .",
    "deploy": "pnpm run build && pnpm exec wrangler deploy --config dist/server/wrangler.json",
    "cf:deploy:prod": "dotenv -e ../../.env.production -e ../../.env.production.local -- pnpm run deploy && pnpm run smoke",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.2",
    "@duyet/components": "*",
    "@duyet/config": "*",
    "@duyet/libs": "*",
    "@duyet/urls": "*",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "cn": "^0.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.16.0",
    "motion": "^13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "tailwindcss": "^4.0.0",
    "typescript": "*",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.118.0"
  }
}
