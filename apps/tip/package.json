{
  "name": "tip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import ../../scripts/force-workspace-react.mjs ../../node_modules/vite/bin/vite.js build && tsx ../../scripts/patch-html-for-cloudflare.ts",
    "check-types": "tsc --noEmit",
    "dev": "vite dev --port 3012",
    "fmt": "biome format --write .",
