{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // react-library.json targets es6, which forbids top-level await. Vite
    // bundles this package for browsers that all support ES2022, and
    // __tests__/Menu.test.ts needs TLA to import a module after `vi.mock`.
    "target": "ES2022"
  },
  "extends": "@duyet/tsconfig/react-library.json",
  "include": ["vite-env.d.ts", "svg.d.ts", ".", "__tests__"],
  "exclude": ["dist", "build", "node_modules"]
}
